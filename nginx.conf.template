# Coach Auto dashboard — static SPA + reverse proxy to the API.
#
# The proxy is what keeps the refresh cookie first-party. Do not remove it in
# favour of pointing the browser straight at the API domain unless you have
# also switched the backend to SameSite=None cookies.
#
# --- Nothing in this file may name a host --------------------------------------
#
# Every origin below is substituted at container start from the environment
# (${API_ORIGIN}, ${API_UPSTREAM}; see the Dockerfile), exactly as in the client
# portal's template. A hostname baked into a built image is a hostname that
# silently rots: this file previously carried a literal API origin in `img-src`,
# and when it stopped matching the API's real address every message attachment
# in the inbox was refused by the browser before a request was made. A
# CSP-blocked image reports as an ordinary load error, so the dashboard showed
# "Tap to retry" on every photo and the API log showed nothing at all.
#
# Two deployment shapes are supported.
#
#   Same-origin. The browser talks only to this server; `/api/` proxies to the
#   backend. Leave VITE_API_URL blank at build time and API_ORIGIN blank here.
#   'self' covers the media and the CSP needs nothing added.
#
#   Split-origin. The browser talks to the API on its own hostname. Set
#   VITE_API_URL at build time and API_ORIGIN here to the same value, scheme
#   included.
#
# The API derives its media origin from the request it is answering, so it
# follows whichever shape is in use without a second setting to keep in sync.
# API_ORIGIN only ever has to match what the browser is actually told to call.

# nginx templates land in the http context, so this map is legal here. It
# exists because the block below must forward the *browser's* protocol, not
# this hop's. Coolify terminates TLS in front of this container, so `$scheme`
# is http on the inside; forwarding that verbatim tells the API it is being
# reached over http, and the media URLs it hands back are then blocked as mixed
# content on an https page.
map $http_x_forwarded_proto $ca_forwarded_proto {
    default $scheme;
    "~^https?$" $http_x_forwarded_proto;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # An internal tool: keep it out of indexes and out of frames.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # frame-src allows the hosted tutorial preview players; the ytimg/vimeocdn
    # entries in img-src are their thumbnails.
    #
    # ${API_ORIGIN} appears in img-src, media-src *and* connect-src. These are
    # separate directives and a wildcard on one covers nothing on another —
    # `media-src https:` was once wide enough to carry the tutorial player by
    # accident while img-src silently refused every attachment in the inbox.
    # If the API is added to one of these it belongs in all three.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://i.vimeocdn.com ${API_ORIGIN}; media-src 'self' blob: ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' ${API_ORIGIN}; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- API proxy ------------------------------------------------------------
    #
    # `^~` stops nginx testing the static-file regex below against API paths.
    # Regex locations are evaluated before prefix ones, so without it a request
    # whose path ends in an image extension would be served from the static
    # root instead of reaching the backend.
    location ^~ /api/ {
        # Resolve the upstream at request time via Docker's internal DNS, so a
        # backend that is slow to start does not stop nginx from booting.
        #
        # A wrong name here is indistinguishable from a dead backend: nginx has
        # nothing to proxy to and answers 502. Verify it against the backend's
        # real service name on this network before assuming it is correct — in
        # Coolify the service name is not always the one in the compose file.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass $api_upstream;
        proxy_http_version 1.1;

        # `Host` is passed through unchanged, and the API reads it to decide
        # what origin to advertise its media at. It is validated against the
        # backend's trusted-host list before use, so a bogus value degrades to
        # a root-relative URL rather than being trusted.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $ca_forwarded_proto;
        proxy_set_header Connection "";

        # The coach's own preview player seeks through uploaded clips, so range
        # requests have to survive the hop in both directions.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_buffering off;
        proxy_request_buffering off;

        # This is the side that uploads tutorial videos. The old 12 MB ceiling
        # rejected every real upload with a 413 before the request reached the
        # API — which is why MAX_VIDEO_UPLOAD_MB appeared to be ignored in
        # production and honoured locally, where Vite's dev proxy has no such
        # limit. Keep this at or above MAX_VIDEO_UPLOAD_MB.
        client_max_body_size 550M;
        client_body_timeout 600s;

        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Static build artefacts only — `^~ /api/` above is matched first.
    location ~* \.(png|jpe?g|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}