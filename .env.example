# ==============================================================================
# Coach Auto — Dashboard
# Vite inlines VITE_* at BUILD time. Changing these needs a rebuild, not a
# restart, so on Coolify set them as build arguments, not runtime variables.
# ==============================================================================

# Where the API lives.
#
# Leave BLANK (recommended). The bundled nginx proxies /api to the backend, so
# the dashboard and the API share one origin. That matters more here than
# anywhere else: the refresh token is an HttpOnly cookie, and a same-origin
# setup keeps it first-party — no SameSite=None, no CORS preflight, no silent
# cookie drops in Safari or a privacy-blocking extension.
#
# Only set this if you deliberately want a cross-origin dashboard. If you do,
# the backend also needs:
#     CORS_ORIGINS   to include this dashboard's URL
#     COOKIE_SAMESITE=none
#     COOKIE_SECURE=true
#     COOKIE_DOMAIN=.autonomyfitness.press
# e.g. VITE_API_URL=https://ca-backend.maktechgroups.com/api/v1
VITE_API_URL=

# The dashboard's own public URL. Used for absolute links in copy-to-clipboard.
VITE_DASHBOARD_URL=https://coach.autonomyfitness.press

# The client portal's public URL, so "view as client" links resolve.
VITE_PORTAL_URL=https://autonomyfitness.press

# Shown in the sidebar footer. Set to "staging" on a preview deploy so nobody
# edits a live client record by accident.
VITE_ENVIRONMENT=production
